(* D.syma — differentiation rules as Syma function definitions *)

(* Constants don't change with respect to any variable *)
D[c_, x_] := 0 /; FreeQ[c, x]

(* d(x)/dx = 1, both args must be the same symbol *)
D[var_, x_] := 1 /; (var == x) && MatchQ[var, _Symbol]

(* Linearity: D(f + g, x) = D(f, x) + D(g, x) *)
D[Plus[f_, g_], x_] := Plus[D[f, x], D[g, x]] /; UnsameQ[f, 0]

(* Power rule with a variable exponent: d(u^v)/dx = u^v (v' Log[u] + v u'/u).
   Must precede the constant-exponent rule so it captures v depending on x. *)
D[Power[u_, v_], x_] := Times[Power[u, v], Plus[Times[D[v, x], Log[u]], Times[v, Power[u, -1], D[u, x]]]] /; !FreeQ[v, x]

(* Power rule with constant exponent: d(u^n)/dx = n*u^(n-1)*u' *)
(* (before the product rule: a bare power such as x^3 can also match the
   OneIdentity-expanded `Times[f_, g_]` pattern with f = 1.) The guard skips
   the synthesized `u^1` fallback (n == 1), which would recurse on bare values. *)
D[Power[u_, n_], x_] := Times[n, Power[u, Plus[n, -1]], D[u, x]] /; !(n == 1)

(* Product rule: D(f*g, x) = D(f,x)*g + f*D(g,x) *)
D[Times[f_, g_], x_] := Plus[Times[D[f, x], g], Times[f, D[g, x]]] /; UnsameQ[f, 1] && UnsameQ[g, 1]
(* Product with an explicit unit factor (e.g. from a normalized Divide). *)
D[Times[1, p_], x_] := D[p, x]
D[Times[p_, 1], x_] := D[p, x]

(* Gauss hypergeometric: d/dz 2F1(a,b;c;z) = (a b / c) 2F1(a+1,b+1;c+1;z).
   Must precede the generic chain rule below. *)
D[Hypergeometric2F1[a_, b_, c_, z_], x_] :=
    Times[a, b, Power[c, -1],
        Hypergeometric2F1[Plus[a, 1], Plus[b, 1], Plus[c, 1], z], D[z, x]]

(* Chain rule for unknown heads: D(f(u), x) = D(f(u), u) * D(u, x)
   Guards: avoid infinite recursion when u == x or func_[u] is the same as the original expression *)
D[func_[u_], x_] := Times[D[func[u], u], D[u, x]] /; (u != x) && (func[u] != func[x])

(* Trigonometric derivatives *)
D[Sin[u_], x_] := Times[Cos[u], D[u, x]]
D[Cos[u_], x_] := Times[-1, Sin[u], D[u, x]]
D[Tan[u_], x_] := Times[Power[Cos[u], -2], D[u, x]]
D[ArcSin[u_], x_] := Times[Power[Plus[1, Times[-1, Power[u, 2]]], -0.5], D[u, x]]
D[ArcCos[u_], x_] := Times[-1, Power[Plus[1, Times[-1, Power[u, 2]]], -0.5], D[u, x]]
D[ArcTan[u_], x_] := Times[Power[Plus[1, Power[u, 2]], -1], D[u, x]]

(* Exponential and logarithmic *)
D[Exp[u_], x_] := Times[Exp[u], D[u, x]]
D[Log[u_], x_] := Times[Power[u, -1], D[u, x]]
D[Log2[u_], x_] := Times[Power[u, -1], Power[2, Log[2]]^(-1), D[u, x]]
D[Log10[u_], x_] := Times[Power[u, -1], Power[10, Log[10]]^(-1), D[u, x]]

(* Square root *)
D[Sqrt[u_], x_] := Times[Power[Times[2, Sqrt[u]], -1], D[u, x]]

(* Higher-order and multi-variable forms. These run through the eval loop, so
   builtin_d (which is shadowed once this file defines D) never sees them. *)
D[f_, x_, 0] := f
D[f_, x_, n_Integer] := D[D[f, x], x, n - 1] /; n >= 1
D[f_, x_, y_] := D[D[f, x], y]

(* Quotient rule and n-ary linearity / product rules. *)
D[Divide[u_, v_], x_] := Divide[
    Plus[Times[D[u, x], v], Times[-1, u, D[v, x]]],
    Power[v, 2]
]
D[Plus[f_, g_, r__], x_] := Plus[D[Plus[f, g], x], D[Plus[r], x]]
D[Times[f_, g_, r__], x_] := Plus[Times[D[Times[f, g], x], r], Times[Times[f, g], D[Times[r], x]]]
